# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (GCP Remote Instance)
# ============================================================================
# Copy this file to .env on remote instance and customize
# Make sure all URLs use your domain: agents.enableyou.co

ENVIRONMENT=production
REACT_APP_API_URL=http://agents.enableyou.co:5000
PUBLIC_URL=http://agents.enableyou.co:5000
OAUTHLIB_INSECURE_TRANSPORT=1

# Google OAuth (get from https://console.cloud.cloud.google.com/)
# Must have callbacks registered:
#   - http://agents.enableyou.co:5000/auth/google/callback
GOOGLE_CLIENT_ID=your_prod_client_id
GOOGLE_CLIENT_SECRET=your_prod_client_secret
GOOGLE_REDIRECT_URI=http://agents.enableyou.co:5000/auth/google/callback

# LinkedIn (optional)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://agents.enableyou.co:5000/auth/linkedin/callback

# Twilio (optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Database
DATABASE_URL=sqlite:///instance/enable_agents.db
