# Executive Assistant Agent Configuration
# Copy this file to .env and fill in your actual credentials

# ============= WHATSAPP CONFIGURATION =============

# Option 1: Twilio WhatsApp Integration (Recommended for Testing)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Option 2: Meta WhatsApp Business API (For Production)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_API_TOKEN=your_meta_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_verify_token

# ============= LINKEDIN CONFIGURATION =============
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5000/linkedin/callback

# ============= OPENAI CONFIGURATION =============
OPENAI_API_KEY=your_openai_api_key

# ============= DATABASE CONFIGURATION =============
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=enable_agents
DB_PORT=3306

# ============= APPLICATION CONFIGURATION =============
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here

# ============= SERVER CONFIGURATION =============
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# ============= FEATURE FLAGS =============
ENABLE_WHATSAPP_INTEGRATION=true
ENABLE_EMAIL_REMINDERS=false
ENABLE_SMS_REMINDERS=false
