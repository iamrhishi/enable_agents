# Deployment Mode: local | remote
# local  = localhost access (dev machine)
# remote = server with nginx reverse proxy (GCP, AWS, etc.)
DEPLOY_MODE=local

# Server Configuration (for remote mode)
SERVER_IP=
DOMAIN=
ADMIN_EMAIL=

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-random-string-in-production

# Application Settings (quote values with spaces if you ever `source` this file)
APP_NAME="Enable Agents"
APP_DESCRIPTION="Multi-Agent AI Platform"

# Runtime URL (auto-set by run.sh based on DEPLOY_MODE)
# local: http://localhost:8000, remote: http://SERVER_IP or https://DOMAIN
PUBLIC_URL=http://localhost:8000

# SPA origin for OAuth redirects to /login (run.sh appends/updates from PUBLIC_URL on remote; optional here)
FRONTEND_URL=http://localhost:3000

# Database Configuration (Docker: host must be `mysql`, not localhost — see docker-compose.yml)
# Local-only example (not for Compose): mysql+mysqlconnector://root:...@host.docker.internal/enable_agents
DATABASE_URI=mysql+mysqlconnector://enable_agents:enable_agents@mysql:3306/enable_agents

# Redis Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Optional: Protect POST /api/context/save and /api/context/search. When set, callers must send
# the same value in header X-Context-Api-Key or Authorization: Bearer <value>.
# Leave unset for open local/demo access.
# CONTEXT_API_SECRET=

# API Keys - OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4-turbo

# API Keys - Google
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must match a redirect URI in Google Cloud Console (Docker dev: backend on host :8000)
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_REFRESH_TOKEN=

# API Keys - Scrap.io (format is often id|secret — must be quoted if you `source` this file)
SCRAP_IO_API_KEY="your-scrap-io-api-key"

# API Keys - Twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Email Configuration (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True

# LinkedIn Configuration
LINKEDIN_ACCESS_TOKEN=your-linkedin-token
LINKEDIN_API_KEY=your-linkedin-api-key

# Figma Configuration
FIGMA_API_TOKEN=your-figma-token

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret

# GitHub Configuration
GITHUB_TOKEN=ghp_your-token
GITHUB_USERNAME=your-username

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/instance/logs/app.log

# Feature Flags
ENABLE_EMAIL_CAMPAIGNS=true
ENABLE_LINKEDIN_EXTRACTION=true
ENABLE_MARKET_RESEARCH=true
ENABLE_COMMUNITY_NETWORK=true
ENABLE_CONTENT_MARKETING=true
ENABLE_EVENT_NETWORKING=true
ENABLE_EXECUTIVE_ASSISTANT=true
ENABLE_SALES_HELPER=true
ENABLE_SUPPLY_CHAIN=true

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000

# Security
CORS_ORIGINS=http://localhost,http://localhost:3000
SESSION_TIMEOUT=3600
MAX_CONTENT_LENGTH=52428800

# Rate Limiting
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URL=memory://

# Caching
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300
