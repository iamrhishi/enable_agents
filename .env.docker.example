# Deployment Mode: local | remote
# local  = localhost access (dev machine, ./run.sh dev)
# remote = server with nginx reverse proxy (GCP/AWS, ./run.sh remote)
DEPLOY_MODE=local

# Server Configuration (only needed for DEPLOY_MODE=remote)
SERVER_IP=
DOMAIN=
ADMIN_EMAIL=

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-me-to-a-random-string-in-production

# Application Settings
APP_NAME=Enable Agents
APP_DESCRIPTION=Multi-Agent AI Platform

# Runtime URL (auto-updated by run.sh for remote mode)
# local: http://localhost:8000, remote: http://SERVER_IP or https://DOMAIN
PUBLIC_URL=http://localhost:8000

# Database — points to the mysql container defined in docker-compose.yml
DATABASE_URI=mysql+mysqlconnector://enable_agents:enable_agents@mysql:3306/enable_agents

# Redis — points to the redis container
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# API Keys - OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo

# API Keys - Google
GOOGLE_API_KEY=your-google-api-key
GOOGLE_SEARCH_ENGINE_ID=your-cse-id
GOOGLE_APPLICATION_CREDENTIALS=/app/config/google-credentials.json
GOOGLE_PLACES_API_KEY=your-google-places-api-key
# Google Sign-In: OAuth client type must be “Web application” (not Desktop / iOS / Android).
# Under that same client, add **all** redirect URIs you might use (Google allows multiple):
#   http://localhost:8000/auth/google/callback
#   http://localhost:5001/auth/google/callback
# The `redirect_uri` in the auth request must match one of these **exactly** (localhost vs 127.0.0.1 differ).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# API Keys - Anthropic
ANTHROPIC_API_KEY=your-anthropic-key

# API Keys - Twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Email Configuration (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True

# LinkedIn Configuration
LINKEDIN_ACCESS_TOKEN=your-linkedin-token
LINKEDIN_API_KEY=your-linkedin-api-key
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# Figma Configuration
FIGMA_API_TOKEN=your-figma-token

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret

# GitHub Configuration
GITHUB_TOKEN=ghp_your-token
GITHUB_USERNAME=your-username

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/instance/logs/app.log

# Feature Flags
ENABLE_EMAIL_CAMPAIGNS=true
ENABLE_LINKEDIN_EXTRACTION=true
ENABLE_MARKET_RESEARCH=true
ENABLE_COMMUNITY_NETWORK=true
ENABLE_CONTENT_MARKETING=true
ENABLE_EVENT_NETWORKING=true
ENABLE_EXECUTIVE_ASSISTANT=true
ENABLE_SALES_HELPER=true
ENABLE_SUPPLY_CHAIN=true

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000

# Security
CORS_ORIGINS=http://localhost,http://localhost:3000
SESSION_TIMEOUT=3600
MAX_CONTENT_LENGTH=52428800

# Rate Limiting
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URL=memory://

# Caching
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300
